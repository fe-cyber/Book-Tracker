@page "/view"
@attribute [StreamRendering]

<PageTitle>View</PageTitle>

<h1>Books</h1>

<p>This component demonstrates showing data.</p>

@if (books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th aria-label="Temperature in Celsius">Title</th>
                <th aria-label="Temperature in Fahrenheit">Author</th>
                <th aria-label="Temperature in Fahrenheit">Rating</th>
                <th aria-label="Temperature in Fahrenheit">Genre</th>
                <th aria-label="Temperature in Fahrenheit">Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Genre</td>
                    <td>@book.Rating</td>
                    <td>@book.Comments</td>
                </tr>
            }
        </tbody>
    </table>
}
